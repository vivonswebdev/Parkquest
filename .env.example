# URL publique de l'app (liens absolus, PWA)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — laissez vide pour lancer le prototype en MODE DÉMO (données locales, rien n'est enregistré)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ SERVEUR UNIQUEMENT — ne jamais préfixer par NEXT_PUBLIC_, ne jamais importer côté client
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox — laissez vide pour utiliser la carte de repli intégrée
NEXT_PUBLIC_MAPBOX_TOKEN=

# Analytics (optionnel, non utilisé dans le MVP)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

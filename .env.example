# ─────────────────────────────────────────────────────────────────────────────
# ParkQuest — variables d'environnement
# Copier en .env.local (jamais commité) :  cp .env.example .env.local
# ─────────────────────────────────────────────────────────────────────────────

# MODE DÉMONSTRATION (recommandé en local)
#   true  → données locales uniquement (src/features/demo/demo-data.ts),
#           GPS / points / badges simulés, AUCUNE clé ni connexion requise.
#   false → utilise Supabase si les clés ci-dessous sont renseignées.
# Sans Supabase configuré, le mode démo s'active de toute façon.
NEXT_PUBLIC_DEMO_MODE=true

# URL de l'app (liens magiques, PWA)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — laisser vide en mode démo
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ SERVEUR UNIQUEMENT — ne jamais préfixer par NEXT_PUBLIC_, ne jamais importer côté client
SUPABASE_SERVICE_ROLE_KEY=

# Cartes — moteur MapLibre GL (open source), fond OpenStreetMap via OpenFreeMap (sans clé).
#   Hors ligne / réseau filtré / sans WebGL : repli automatique sur la carte simplifiée intégrée.
# Forcer la carte simplifiée (tests, appareils anciens) : fallback
NEXT_PUBLIC_MAP_ENGINE=
# Autre style MapLibre compatible OpenMapTiles (MapTiler, Stadia, auto-hébergé…) ; vide = OpenFreeMap
NEXT_PUBLIC_MAP_STYLE_URL=
# Mapbox (optionnel) : active la vue satellite. Token public `pk.…` restreint à vos domaines.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Ou tuiles satellite raster d'un autre fournisseur ({z}/{x}/{y}) + mention obligatoire
NEXT_PUBLIC_SATELLITE_TILES_URL=
NEXT_PUBLIC_SATELLITE_ATTRIBUTION=
# Relief 3D : vide = « Terrain Tiles » (AWS Open Data, encodage Terrarium)
NEXT_PUBLIC_TERRAIN_TILES_URL=

# Météo pendant la visite (Open-Meteo, sans clé)
#   En mode démo, la météo est SIMULÉE (aucun appel réseau) et affichée comme telle.
#   true → appelle réellement Open-Meteo même en mode démo (nécessite Internet).
#   Usage commercial : Open-Meteo exige un abonnement payant — voir docs/FUTURE_SOCIAL_AND_LOCATION_SHARING.md.
WEATHER_LIVE=false

# Analytics (optionnel, non utilisé)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Développement : origines supplémentaires autorisées (tunnel, IP locale), séparées par des virgules.
# `npm run dev:lan` ajoute automatiquement les IP du réseau local.
PQ_ALLOWED_DEV_ORIGINS=

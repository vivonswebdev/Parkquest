{
  "name": "parkquest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:demo": "cross-env NEXT_PUBLIC_DEMO_MODE=true next dev",
    "dev:lan": "node scripts/dev-lan.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "db:seed:generate": "tsx scripts/generate-seed.ts",
    "db:test": "bash scripts/db-test.sh",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "demo:illustrations": "tsx scripts/generate-illustrations.ts",
    "pwa:icons": "tsx scripts/generate-icons.ts",
    "test:e2e": "playwright test",
    "demo:capture": "npm run verify && node scripts/capture-demo.mjs",
    "test": "npm run i18n:check && tsx --test --test-reporter=spec \"tests/unit/**/*.test.ts\"",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "check": "npm run verify"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "mapbox-gl": "^3.31.0",
    "next": "16.3.6",
    "next-intl": "^4.14.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright": "^1.56.1",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
